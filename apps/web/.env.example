# Vercel's Supabase integration provides these. For local development, use
# connection strings from this product's new Supabase project only. Use the
# transaction pooler (6543) for serverless runtime traffic and the session/direct
# connection (5432) for Prisma migrations. Never use either source project's DB.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DB_OR_SESSION_HOST:5432/postgres
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# The Vercel Supabase integration provides these public Auth client settings.
# The publishable key is preferred; the legacy anon key is accepted as fallback.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay credentials for this product only; keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Google Drive server credentials for private media streams.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_DRIVE_API_KEY=
