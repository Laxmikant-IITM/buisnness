# Use a fresh database dedicated to this product. Never point this at either source project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lms?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Razorpay credentials for this product only; keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Google Drive server credentials for private media streams.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_DRIVE_API_KEY=
