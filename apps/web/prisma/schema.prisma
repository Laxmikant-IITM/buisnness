generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are strings rather than an enum so adding a future business role does
// not require coupling role names to a generated database enum migration.
model User {
  id                         String              @id @default(cuid())
  name                       String
  email                      String              @unique
  passwordHash               String?
  role                       String              @default("STUDENT")
  isActive                   Boolean             @default(true)
  tokenVersion               Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  createdCourses             Course[]            @relation("CourseCreator")
  courseStaffAccess          CourseStaffAccess[] @relation("CourseStaffMember")
  courseStaffAssignmentsMade CourseStaffAccess[] @relation("CourseStaffAssigner")
  enrollments                Enrollment[]
  orders                     Order[]
  couponUsages               CouponUsage[]
  progress                   LectureProgress[]
  activity                   ActivityLog[]
  authoredQuestions          Question[]          @relation("QuestionAuthor")
  createdQuizzes             Quiz[]              @relation("QuizCreator")
  quizAttempts               QuizAttempt[]

  @@index([role, isActive])
}

model Course {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String?
  status      String              @default("DRAFT")
  thumbnail   String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation("CourseCreator", fields: [createdById], references: [id])
  offerings   CourseOffering[]
  enrollments Enrollment[]
  topics      Topic[]
  orderItems  OrderItem[]
  staffAccess CourseStaffAccess[]
  questions   Question[]
  quizzes     Quiz[]

  @@index([status, createdAt])
}

// Course-scoped staff access keeps ADMIN and INSTRUCTOR privileges out of
// unrelated courses. Assignment APIs must allow only ADMIN or INSTRUCTOR accounts.
model CourseStaffAccess {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  assignedById String
  createdAt    DateTime @default(now())
  user         User     @relation("CourseStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("CourseStaffAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId, userId])
}

// A course can have more than one sellable access plan (for example recorded
// access and live access). The price is stored as integer paise to avoid floats.
model CourseOffering {
  id           String       @id @default(cuid())
  courseId     String
  name         String
  accessType   String       @default("RECORDED")
  pricePaise   Int
  currency     String       @default("INR")
  durationDays Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  enrollments  Enrollment[]

  @@index([courseId, isActive])
}

model Enrollment {
  id         String          @id @default(cuid())
  userId     String
  courseId   String
  offeringId String?
  accessType String          @default("RECORDED")
  status     String          @default("ACTIVE")
  startsAt   DateTime        @default(now())
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offering   CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, accessType])
  @@index([courseId, status])
}

model Topic {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content   Content[]

  @@index([courseId, order])
}

model Content {
  id            String            @id @default(cuid())
  topicId       String
  title         String
  description   String?
  videoUrl      String?
  youtubeUrl    String?
  videoSource   String            @default("GOOGLE_DRIVE")
  videoVariants Json?
  duration      String?
  isDemo        Boolean           @default(false)
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  topic         Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress      LectureProgress[]

  @@index([topicId, order])
}

model LectureProgress {
  id            String   @id @default(cuid())
  userId        String
  contentId     String
  status        String   @default("NOT_STARTED")
  videoPosition Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, updatedAt])
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  discountType       String // PERCENT or FIXED_PAISE
  discountValue      Int
  minOrderPaise      Int?
  startsAt           DateTime?
  expiresAt          DateTime?
  maxUses            Int?
  currentUses        Int           @default(0)
  isSingleUsePerUser Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  usages             CouponUsage[]
  orders             Order[]

  @@index([isActive, expiresAt])
}

model Order {
  id                String       @id @default(cuid())
  userId            String
  couponId          String?
  subtotalPaise     Int
  discountPaise     Int          @default(0)
  totalPaise        Int
  currency          String       @default("INR")
  status            String       @default("PENDING")
  razorpayOrderId   String?      @unique
  razorpayPaymentId String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon            Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  couponUsage       CouponUsage?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                    String          @id @default(cuid())
  orderId               String
  courseId              String
  offeringId            String?
  courseTitleSnapshot   String
  offeringTitleSnapshot String
  accessType            String
  unitPricePaise        Int
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course                Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  offering              CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([courseId])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  eventType       String
  orderId         String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@index([orderId, receivedAt])
}

// Reliable follow-up work (email, receipts, analytics) is drained by a worker;
// it lets payment settlement and access granting remain atomic and repeatable.
model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  @@index([status, availableAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

// The question bank is course scoped when attached to a course. A null courseId
// is reserved for platform managers' reusable questions; route authorization
// must enforce that rule because PostgreSQL nullable relations cannot encode it.
model Question {
  id          String           @id @default(cuid())
  courseId    String?
  createdById String
  type        String           @default("MULTIPLE_CHOICE_SINGLE")
  prompt      String
  explanation String?
  difficulty  String?
  tags        String[]         @default([])
  status      String           @default("DRAFT")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  choices     QuestionChoice[]
  quizItems   QuizItem[]

  @@index([courseId, status, updatedAt])
  @@index([createdById, createdAt])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  text       String
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

model Quiz {
  id               String        @id @default(cuid())
  courseId         String
  createdById      String
  title            String
  description      String?
  status           String        @default("DRAFT")
  timeLimitSeconds Int?
  maxAttempts      Int?
  passMarkPercent  Int?
  shuffleQuestions Boolean       @default(false)
  shuffleChoices   Boolean       @default(false)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy        User          @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items            QuizItem[]
  attempts         QuizAttempt[]

  @@index([courseId, status, createdAt])
}

// questionSnapshot freezes wording and answer keys at publish time, so later
// question-bank edits cannot change an already published or attempted quiz.
model QuizItem {
  id               String    @id @default(cuid())
  quizId           String
  questionId       String?
  order            Int       @default(0)
  points           Int       @default(1)
  questionSnapshot Json?
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question         Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([quizId, order])
  @@index([quizId])
}

model QuizAttempt {
  id                String       @id @default(cuid())
  quizId            String
  userId            String
  attemptNumber     Int
  status            String       @default("IN_PROGRESS")
  startedAt         DateTime     @default(now())
  submittedAt       DateTime?
  earnedPoints      Int          @default(0)
  possiblePoints    Int          @default(0)
  percent           Int?
  presentationOrder Json?
  quiz              Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           QuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
  @@index([userId, startedAt])
  @@index([quizId, status])
}

model QuizAnswer {
  id                String      @id @default(cuid())
  attemptId         String
  quizItemId        String
  selectedChoiceIds String[]    @default([])
  isCorrect         Boolean?
  earnedPoints      Int         @default(0)
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, quizItemId])
  @@index([attemptId])
}
