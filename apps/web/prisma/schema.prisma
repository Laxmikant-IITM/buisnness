generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel's Supabase integration supplies a pooled Prisma URL for runtime
  // traffic and a direct URL for schema migrations.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Roles are strings rather than an enum so adding a future business role does
// not require coupling role names to a generated database enum migration.
model User {
  id                         String                    @id @default(cuid())
  name                       String
  email                      String                    @unique
  passwordHash               String?
  role                       String                    @default("STUDENT")
  isActive                   Boolean                   @default(true)
  tokenVersion               Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  googleId                   String?                   @unique
  avatar                     String?
  mobileNumber               String?
  gender                     String?
  age                        Int?
  state                      String?
  aboutMe                    String?
  instagramUrl               String?
  linkedinUrl                String?
  securityNumber             String?                   @unique // internal tracking ID
  iitmLevel                  String? // Qualifier, Foundation, Diploma, Degree
  iitmUserType               String?
  iitmJoinYear               Int?
  iitmJoinMonth              Int?
  isTerminated               Boolean                   @default(false)
  isProfileComplete          Boolean                   @default(false)
  isGoogleUser               Boolean                   @default(false)
  hasSeenWelcome             Boolean                   @default(false)
  xp                         Int                       @default(0)
  highestLevelReached        Int                       @default(1)
  lastSeenAt                 DateTime?
  streakDays                 Int                       @default(0)
  lastStreakDate             DateTime?
  walletBalance              Int                       @default(0) // coins, 1 coin = 1 paise equivalent
  lifetimeReferrals          Int                       @default(0)
  quarterlyReferrals         Int                       @default(0)
  referralCode               String?                   @unique // 5-char unique code
  quarterStartDate           DateTime?
  createdCourses             Course[]                  @relation("CourseCreator")
  courseStaffAccess          CourseStaffAccess[]       @relation("CourseStaffMember")
  courseStaffAssignmentsMade CourseStaffAccess[]       @relation("CourseStaffAssigner")
  enrollments                Enrollment[]
  orders                     Order[]
  couponUsages               CouponUsage[]
  progress                   LectureProgress[]
  activity                   ActivityLog[]
  authoredQuestions          Question[]                @relation("QuestionAuthor")
  createdQuizzes             Quiz[]                    @relation("QuizCreator")
  quizAttempts               QuizAttempt[]
  instructorAssignments      InstructorAssignment[]    @relation("InstructorUser")
  assignedInstructors        InstructorAssignment[]    @relation("InstructorAssigner")
  comments                   Comment[]
  homeworkSubmissions        HomeworkSubmission[]
  communityMessages          CommunityMessage[]
  communityReadStates        CommunityReadState[]
  communityMutePreferences   CommunityMutePreference[]
  initiatedChatSessions      ChatSession[]             @relation("ChatSessionInitiator")
  assignedChatSessions       ChatSession[]             @relation("ChatSessionAssignee")
  chatMessages               ChatMessage[]
  supportTickets             SupportTicket[]           @relation("TicketCreator")
  assignedSupportTickets     SupportTicket[]           @relation("TicketAssignee")
  ticketReplies              TicketReply[]
  featureRequests            FeatureRequest[]
  filedReports               UserReport[]              @relation("ReportReporter")
  reportsReceived            UserReport[]              @relation("ReportTarget")
  reviewedReports            UserReport[]              @relation("ReportReviewer")
  reportAuditLogs            UserReportAudit[]
  notifications              Notification[]
  notificationLogs           NotificationLog[]
  pushSubscriptions          PushSubscription[]
  fcmTokens                  FcmDeviceToken[]
  announcements              Announcement[]            @relation("AnnouncementCreator")
  pollResponses              PollResponse[]
  promptResponses            PromptResponse[]
  loginLogs                  LoginLog[]
  deletionRequests           AccountDeletionRequest[]
  groupSyncJobs              GroupSyncJob[]
  authoredBlogs              Blog[]                    @relation("BlogAuthor")
  oneOnOneBookings           OneOnOneBooking[]
  ownedExams                 ProctoredExam[]           @relation("ExamOwner")
  examEnrollments            ProctoredExamEnrollment[]
  examSessions               ProctoredExamSession[]
  examEvents                 ProctoredExamEvent[]
  examMessages               ProctoredExamMessage[]
  examAuditLogs              ProctoredExamAuditLog[]
  ideSubmissions             IdeSubmission[]
  discussions                Discussion[]
  discussionReplies          DiscussionReply[]
  discussionVotes            DiscussionVote[]
  proSubscriptions           ProSubscription[]
  reviewedQuizzes            Quiz[]                    @relation("QuizReviewer")
  personalQuizzes            Quiz[]                    @relation("QuizPersonalOwner")
  quizEntitlements           QuizEntitlement[]
  questionReportsFiled       QuestionReport[]          @relation("QuestionReporter")
  questionReportsResolved    QuestionReport[]          @relation("QuestionReportResolver")
  badges                     UserBadge[]

  @@index([role, isActive])
  @@index([securityNumber])
  @@index([referralCode])
  @@index([lastSeenAt])
}

model Course {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  title                    String
  description              String?
  status                   String                    @default("DRAFT")
  thumbnail                String?
  createdById              String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  subject                  String?
  color                    String?
  icon                     String?
  teacherName              String?
  googleGroupEmail         String?
  communityLink            String?
  contentLink              String?
  isCommunityActive        Boolean                   @default(false)
  isDisabled               Boolean                   @default(false)
  isDemo                   Boolean                   @default(false)
  isFree                   Boolean                   @default(false)
  isGlobal                 Boolean                   @default(false)
  academicTerm             String?
  academicYear             String?
  examCycle                String?
  liveUpgradePrice         Int? // paise
  demoPrice                Int? // paise
  pricingOptions           Json? // array of {name, price, type, tag}
  tags                     String[]                  @default([])
  courseCategory           String? // QUALIFIER, LIVE, RECORDED
  term                     String? // Qualifier, Foundation, DIPLOMA
  examStages               String[]                  @default([])
  videoUrl                 String? // preview video
  createdBy                User                      @relation("CourseCreator", fields: [createdById], references: [id])
  offerings                CourseOffering[]
  enrollments              Enrollment[]
  topics                   Topic[]
  orderItems               OrderItem[]
  staffAccess              CourseStaffAccess[]
  questions                Question[]
  quizzes                  Quiz[]
  instructorAssignments    InstructorAssignment[]
  materials                Material[]
  homeworks                Homework[]
  events                   CourseEvent[]
  communityMessages        CommunityMessage[]
  communityReadStates      CommunityReadState[]
  communityMutePreferences CommunityMutePreference[]
  announcements            Announcement[]
  groupSyncJobs            GroupSyncJob[]
  analyticsDaily           AnalyticsCourseDaily[]
  bundleItems              CourseBundleItem[]
  ideProblems              IdeProblem[]
  videoSolutions           VideoSolution[]
  discussions              Discussion[]

  @@index([status, createdAt])
  @@index([courseCategory, term])
  @@index([isGlobal, isDisabled])
}

// Course-scoped staff access keeps ADMIN and INSTRUCTOR privileges out of
// unrelated courses. Assignment APIs must allow only ADMIN or INSTRUCTOR accounts.
model CourseStaffAccess {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  assignedById String
  createdAt    DateTime @default(now())
  user         User     @relation("CourseStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("CourseStaffAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId, userId])
}

// A course can have more than one sellable access plan (for example recorded
// access and live access). The price is stored as integer paise to avoid floats.
model CourseOffering {
  id           String       @id @default(cuid())
  courseId     String
  name         String
  accessType   String       @default("RECORDED")
  pricePaise   Int
  currency     String       @default("INR")
  durationDays Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  enrollments  Enrollment[]

  @@index([courseId, isActive])
}

model Enrollment {
  id         String          @id @default(cuid())
  userId     String
  courseId   String
  offeringId String?
  accessType String          @default("RECORDED")
  status     String          @default("ACTIVE")
  startsAt   DateTime        @default(now())
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offering   CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, accessType])
  @@index([courseId, status])
}

model Topic {
  id             String               @id @default(cuid())
  courseId       String
  title          String
  order          Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content        Content[]
  sharedContents TopicSharedContent[]

  @@index([courseId, order])
}

model Content {
  id            String               @id @default(cuid())
  topicId       String
  title         String
  description   String?
  videoUrl      String?
  youtubeUrl    String?
  videoSource   String               @default("GOOGLE_DRIVE")
  videoVariants Json?
  duration      String?
  isDemo        Boolean              @default(false)
  order         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  topic         Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress      LectureProgress[]
  sharedTopics  TopicSharedContent[]
  comments      Comment[]

  @@index([topicId, order])
}

model LectureProgress {
  id            String   @id @default(cuid())
  userId        String
  contentId     String
  status        String   @default("NOT_STARTED")
  videoPosition Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, updatedAt])
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  discountType       String // PERCENT or FIXED_PAISE
  discountValue      Int
  minOrderPaise      Int?
  startsAt           DateTime?
  expiresAt          DateTime?
  maxUses            Int?
  currentUses        Int           @default(0)
  isSingleUsePerUser Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  usages             CouponUsage[]
  orders             Order[]

  @@index([isActive, expiresAt])
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  couponId          String?
  subtotalPaise     Int
  discountPaise     Int               @default(0)
  totalPaise        Int
  currency          String            @default("INR")
  status            String            @default("PENDING")
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  couponUsage       CouponUsage?
  quizEntitlements  QuizEntitlement[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                    String          @id @default(cuid())
  orderId               String
  courseId              String
  offeringId            String?
  courseTitleSnapshot   String
  offeringTitleSnapshot String
  accessType            String
  unitPricePaise        Int
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course                Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  offering              CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([courseId])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  eventType       String
  orderId         String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@index([orderId, receivedAt])
}

// Reliable follow-up work (email, receipts, analytics) is drained by a worker;
// it lets payment settlement and access granting remain atomic and repeatable.
model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  @@index([status, availableAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

// The question bank is course scoped when attached to a course. A null courseId
// is reserved for platform managers' reusable questions; route authorization
// must enforce that rule because PostgreSQL nullable relations cannot encode it.
model Question {
  id                     String                  @id @default(cuid())
  courseId               String?
  createdById            String
  type                   String                  @default("MULTIPLE_CHOICE_SINGLE")
  prompt                 String
  explanation            String?
  difficulty             String?
  tags                   String[]                @default([])
  status                 String                  @default("DRAFT")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  stemImage              String?
  stemCode               String?
  stemCodeLanguage       String?
  stemTable              Json?
  numericalAnswer        Float?
  numericalTolerance     Float?
  course                 Course?                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy              User                    @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  choices                QuestionChoice[]
  quizItems              QuizItem[]
  reports                QuestionReport[]
  shortAnswerAcceptables ShortAnswerAcceptable[]

  @@index([courseId, status, updatedAt])
  @@index([createdById, createdAt])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  text       String
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

model Quiz {
  id               String            @id @default(cuid())
  courseId         String
  createdById      String
  title            String
  description      String?
  status           String            @default("DRAFT")
  timeLimitSeconds Int?
  maxAttempts      Int?
  passMarkPercent  Int?
  shuffleQuestions Boolean           @default(false)
  shuffleChoices   Boolean           @default(false)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  section          String? // practice, quiz1, quiz2, endterm, mock_test
  year             Int?
  pricePaise       Int? // for paper storefront
  accessDays       Int?
  approvalStatus   String            @default("approved") // pending, approved
  reviewedById     String?
  isPersonal       Boolean           @default(false)
  ownerUserId      String?
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy       User?             @relation("QuizReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  ownerUser        User?             @relation("QuizPersonalOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  items            QuizItem[]
  attempts         QuizAttempt[]
  entitlements     QuizEntitlement[]
  questionReports  QuestionReport[]
  discussions      Discussion[]

  @@index([courseId, status, createdAt])
  @@index([reviewedById])
  @@index([ownerUserId])
  @@index([approvalStatus])
}

// questionSnapshot freezes wording and answer keys at publish time, so later
// question-bank edits cannot change an already published or attempted quiz.
model QuizItem {
  id               String    @id @default(cuid())
  quizId           String
  questionId       String?
  order            Int       @default(0)
  points           Int       @default(1)
  questionSnapshot Json?
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question         Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([quizId, order])
  @@index([quizId])
}

model QuizAttempt {
  id                String       @id @default(cuid())
  quizId            String
  userId            String
  attemptNumber     Int
  status            String       @default("IN_PROGRESS")
  startedAt         DateTime     @default(now())
  submittedAt       DateTime?
  earnedPoints      Int          @default(0)
  possiblePoints    Int          @default(0)
  percent           Int?
  presentationOrder Json?
  quiz              Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           QuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
  @@index([userId, startedAt])
  @@index([quizId, status])
}

model QuizAnswer {
  id                String      @id @default(cuid())
  attemptId         String
  quizItemId        String
  selectedChoiceIds String[]    @default([])
  isCorrect         Boolean?
  earnedPoints      Int         @default(0)
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, quizItemId])
  @@index([attemptId])
}

// =========================================================================
// TEACHING LLM & COMMUNITY MODELS
// =========================================================================

// Explicit junction mapping instructors to courses with tracking of the staff member
// who granted access, enabling multi-instructor courses and access audits.
model InstructorAssignment {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  assignedById String
  createdAt    DateTime @default(now())
  user         User     @relation("InstructorUser", fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("InstructorAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId, userId])
  @@index([assignedById])
}

// Allows a single piece of lecture content to be shared across multiple topics
// or courses without duplicating media metadata or progress tracking.
model TopicSharedContent {
  id        String   @id @default(cuid())
  topicId   String
  contentId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([topicId, contentId])
  @@index([topicId, order])
  @@index([contentId])
}

// Threaded discussions attached directly to lectures/content.
// Uses parentId for self-referential nesting of replies.
model Comment {
  id        String    @id @default(cuid())
  userId    String
  contentId String
  parentId  String?
  body      String
  isEdited  Boolean   @default(false)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([contentId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// Study materials, lecture notes, formula sheets, and past year question papers.
// Can be scoped to a specific course or marked global across an entire academic level.
model Material {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  description String?
  fileUrl     String
  fileType    String // PDF, DOCX, ZIP, etc.
  category    String // NOTE, ASSIGNMENT, PYQ, OTHER
  level       String? // Qualifier, Foundation, Diploma, Degree
  subject     String?
  term        String?
  isFree      Boolean  @default(false)
  isGlobal    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, category, order])
  @@index([isGlobal, level, subject])
}

// Course assignments with due dates and submission deadlines.
// File attachments are stored in a JSON array.
model Homework {
  id          String               @id @default(cuid())
  courseId    String
  title       String
  description String?
  fileUrls    Json? // Array of download URLs
  dueAt       DateTime?
  isOpen      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([courseId, isOpen, dueAt])
}

// Student submissions for homework assignments with uploaded artifacts and grading feedback.
model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  userId      String
  fileUrls    Json // Array of student upload URLs
  note        String?
  score       Int?
  feedback    String?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, userId])
  @@index([userId, submittedAt])
  @@index([homeworkId])
}

// Live lectures, office hours, doubt solving, and webinars with streaming integrations.
model CourseEvent {
  id                String                 @id @default(cuid())
  courseId          String
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  meetLink          String?
  type              String                 @default("LIVE_CLASS") // LIVE_CLASS, WEBINAR, MENTORSHIP
  recurrence        String? // NONE, DAILY, WEEKLY
  streamProvider    String                 @default("MEET") // MEET, YOUTUBE, DRIVE, AGORA
  agoraChannelName  String?
  streamStatus      String                 @default("SCHEDULED") // SCHEDULED, LIVE, ENDED
  notified15mBefore Boolean                @default(false)
  notifiedAtStart   Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dailySnapshots    DailySessionSnapshot[]

  @@index([courseId, startTime])
  @@index([streamStatus, startTime])
}

// Immutable daily record of attendance, participation, and telemetry for live course events.
model DailySessionSnapshot {
  id            String      @id @default(cuid())
  courseEventId String
  snapshotDate  DateTime
  data          Json
  createdAt     DateTime    @default(now())
  courseEvent   CourseEvent @relation(fields: [courseEventId], references: [id], onDelete: Cascade)

  @@unique([courseEventId, snapshotDate])
  @@index([snapshotDate])
}

// Real-time group chat messages inside a course community channel.
model CommunityMessage {
  id              String             @id @default(cuid())
  courseId        String
  userId          String
  content         String
  imageUrl        String?
  isPinned        Boolean            @default(false)
  isEdited        Boolean            @default(false)
  likes           Int                @default(0)
  reactions       Json? // Map of emoji to user ID arrays
  replyToId       String?
  isSystemDeleted Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo         CommunityMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         CommunityMessage[] @relation("MessageReplies")

  @@index([courseId, createdAt])
  @@index([userId])
  @@index([replyToId])
}

// Tracks the timestamp up to which a user has read messages in a course community.
model CommunityReadState {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, userId])
}

// User notification suppression settings per course community.
model CommunityMutePreference {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  isMuted    Boolean   @default(true)
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// Direct messaging or support help desk conversation threads.
model ChatSession {
  id          String        @id @default(cuid())
  type        String        @default("SUPPORT") // SUPPORT, DIRECT
  status      String        @default("WAITING") // WAITING, ACTIVE, CLOSED
  initiatorId String
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  initiator   User          @relation("ChatSessionInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("ChatSessionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]

  @@index([status, updatedAt])
  @@index([initiatorId])
  @@index([assigneeId])
}

// Individual messages sent within a support or direct chat session.
model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  senderId      String
  content       String
  imageUrl      String?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
  @@index([senderId])
}

// Customer support and academic helpdesk tickets tracked through resolution.
model SupportTicket {
  id           String        @id @default(cuid())
  userId       String
  subject      String
  body         String
  status       String        @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String        @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies      TicketReply[]

  @@index([userId, status])
  @@index([status, priority, createdAt])
  @@index([assignedToId])
}

// Threaded messages and resolution updates on support tickets.
model TicketReply {
  id         String        @id @default(cuid())
  ticketId   String
  userId     String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([userId])
}

// Student feature feedback and roadmap suggestions with voting.
model FeatureRequest {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, PLANNED, IN_PROGRESS, COMPLETED, DECLINED
  votes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, votes])
  @@index([userId])
}

// User misconduct and community guideline violation reports.
model UserReport {
  id             String            @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  status         String            @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  reviewedById   String?
  resolution     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reporter       User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User              @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy     User?             @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditLogs      UserReportAudit[]

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
}

// Immutable moderation audit trail recording actions taken on misconduct reports.
model UserReportAudit {
  id        String     @id @default(cuid())
  reportId  String
  actorId   String
  action    String
  details   String?
  createdAt DateTime   @default(now())
  report    UserReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor     User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([actorId])
}

// In-app notifications delivered to students for updates, deadlines, and events.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("GENERAL") // GENERAL, COURSE, EXAM, COMMUNITY
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// Delivery audit log tracking push notifications dispatched via FCM and Web Push.
model NotificationLog {
  id          String   @id @default(cuid())
  recipientId String?
  channel     String // FCM, WEB_PUSH, IN_APP
  title       String
  body        String
  status      String   @default("SENT") // SENT, FAILED, PENDING
  error       String?
  sentAt      DateTime @default(now())
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([recipientId, sentAt])
  @@index([status, channel, sentAt])
}

// Web Push API credentials for browser-level desktop and mobile notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Firebase Cloud Messaging tokens registered by native iOS and Android apps.
model FcmDeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Scheduled broadcast announcements sent to targeted cohorts of users.
model NotificationCampaign {
  id           String   @id @default(cuid())
  title        String
  body         String
  targetType   String // ALL, COURSE, LEVEL, ROLE
  targetId     String?
  scheduledFor DateTime
  status       String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, CANCELLED
  sentCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledFor])
}

// Platform-wide or course-scoped banner broadcasts displayed to learners.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  courseId    String?
  targetType  String    @default("ALL") // ALL, COURSE, ROLE, LEVEL
  isActive    Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  polls       Poll[]

  @@index([courseId, isActive, startsAt])
  @@index([isActive, startsAt, endsAt])
}

// Interactive polls embedded inside platform or course announcements.
model Poll {
  id             String         @id @default(cuid())
  announcementId String
  question       String
  createdAt      DateTime       @default(now())
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  options        PollOption[]
  responses      PollResponse[]

  @@index([announcementId])
}

// Candidate options for an embedded poll.
model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  text      String
  order     Int            @default(0)
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]

  @@index([pollId, order])
}

// Cast votes by users on specific poll options.
model PollResponse {
  id           String     @id @default(cuid())
  pollId       String
  pollOptionId String
  userId       String
  createdAt    DateTime   @default(now())
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollOptionId])
  @@index([userId])
}

// Modal alerts notifying learners about critical platform features and releases.
model SystemUpdate {
  id          String   @id @default(cuid())
  title       String
  body        String
  isActive    Boolean  @default(true)
  duration    Int? // Auto-dismiss duration in seconds
  targetPages Json? // URL paths where modal should render
  animation   String? // Visual entrance animation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Dynamic key-value configuration repository for platform runtime settings.
model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String // Text or stringified JSON config
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// Mandatory surveys or onboarding questions prompted to users upon authentication.
model UserPrompt {
  id         String           @id @default(cuid())
  title      String
  body       String
  type       String           @default("YES_NO") // YES_NO, MCQ, CTA
  options    Json? // Choices for MCQ prompts
  isActive   Boolean          @default(true)
  isRequired Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  responses  PromptResponse[]

  @@index([isActive, isRequired])
}

// Learner answers to user prompts and onboarding surveys.
model PromptResponse {
  id        String     @id @default(cuid())
  promptId  String
  userId    String
  response  String
  createdAt DateTime   @default(now())
  prompt    UserPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promptId, userId])
  @@index([userId])
}

// Marketing banners and hero carousel slides displayed on the homepage.
model HomeSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// Gamified trivia, facts, and surprise coupons shown on loading splash screens.
model LoadingFact {
  id         String   @id @default(cuid())
  text       String
  category   String   @default("general")
  rarity     String   @default("COMMON") // COMMON, RARE, EPIC, LEGENDARY
  couponCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([isActive, category])
}

// Frequently asked questions organized by category for help centers.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order, isActive])
}

// Security audit log recording login timestamps, device user agents, and IP addresses.
model LoginLog {
  id         String   @id @default(cuid())
  userId     String
  userAgent  String?
  authMethod String // email, google, otp
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Self-service account deletion requests held in a grace period before purge.
model AccountDeletionRequest {
  id                String   @id @default(cuid())
  userId            String
  reason            String
  details           String?
  status            String   @default("PENDING") // PENDING, REVIEWING, COMPLETED, CANCELLED
  gracePeriodEndsAt DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, gracePeriodEndsAt])
}

// Asynchronous sync queue synchronizing course enrollments with Google Workspace Groups.
model GroupSyncJob {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  action    String // ADD, REMOVE
  status    String   @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([courseId, userId])
}

// Daily aggregated platform-level engagement metrics for dashboards.
model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @unique
  activeUsers Int      @default(0)
  data        Json
  createdAt   DateTime @default(now())

  @@index([date])
}

// Per-course daily active learner and enrollment aggregates.
model AnalyticsCourseDaily {
  id             String   @id @default(cuid())
  courseId       String
  date           DateTime
  enrollments    Int      @default(0)
  activeStudents Int      @default(0)
  data           Json?
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, date])
  @@index([courseId, date])
}

// =========================================================================
// GENZIITIAN COMMERCIAL & GROWTH MODELS
// =========================================================================

// Financial tracking of referral discounts, referee orders, and coin rewards.
// All monetary values stored as integer paise.
model ReferralTransaction {
  id             String   @id @default(cuid())
  referrerEmail  String
  buyerEmail     String
  referralCode   String
  orderId        String?
  originalPrice  Int // paise
  buyerDiscount  Int // paise
  finalPrice     Int // paise
  referrerReward Int // paise / coins
  coinsUsed      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([referralCode])
  @@index([referrerEmail, createdAt])
  @@index([buyerEmail])
  @@index([orderId])
}

// Tiered coin reward bonuses awarded when student referrals cross thresholds.
model ReferralMilestone {
  referralsRequired Int      @id
  bonusCoins        Int
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Packages multiple complementary courses together into a single sellable package.
model CourseBundle {
  id          String             @id @default(cuid())
  name        String
  description String?
  slug        String             @unique
  thumbnail   String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       CourseBundleItem[]
  offerings   BundleOffering[]

  @@index([isActive])
}

// Junction linking courses to course bundles with presentation ordering.
model CourseBundleItem {
  id       String       @id @default(cuid())
  bundleId String
  courseId String
  order    Int          @default(0)
  bundle   CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
  @@index([bundleId, order])
  @@index([courseId])
}

// Commercial pricing plans for multi-course bundles with paise-denominated amounts.
model BundleOffering {
  id                 String       @id @default(cuid())
  bundleId           String
  name               String
  accessType         String       @default("FULL")
  pricePaise         Int
  discountPricePaise Int?
  currency           String       @default("INR")
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  bundle             CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId, isActive])
}

// Directory of instructors, teaching assistants, operators, and staff members.
model Employee {
  id          String        @id @default(cuid())
  employeeId  String        @unique
  fullName    String
  email       String        @unique
  phone       String?
  department  String
  role        String
  tenure      String?
  status      String        @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED
  photoUrl    String?
  dateOfBirth DateTime?
  joinedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  logs        EmployeeLog[]

  @@index([department, status])
  @@index([status])
}

// Audit log recording HR, role, or profile modifications made to employee records.
model EmployeeLog {
  id         String   @id @default(cuid())
  employeeId String
  actorEmail String
  actionType String // CREATE, UPDATE, DELETE, VERIFY
  details    Json?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([actorEmail])
}

// Editorial blog posts, learning guides, and articles with SEO metadata.
model Blog {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  content        String
  imageUrl       String?
  date           DateTime @default(now())
  readTime       String?
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[] @default([])
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User?    @relation("BlogAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([isPublished, date])
  @@index([category])
}

// Centralized academic resources library categorizing formulas, notes, and pyqs.
model Resource {
  id           String   @id @default(cuid())
  level        String // Qualifier, Foundation, Diploma, Degree
  subject      String
  resourceType String // notes, pyq
  subType      String?
  title        String
  description  String?
  url          String
  isPublished  Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([level, subject, resourceType, isPublished])
}

// Applications submitted by candidates seeking teaching or operational roles.
model JobApplication {
  id           String   @id @default(cuid())
  role         String
  roleTitle    String
  fullName     String
  email        String
  phone        String
  age          Int?
  gender       String?
  studentType  String?
  degreeLevel  String?
  experience   String?
  status       String   @default("PENDING") // PENDING, REVIEWED, SHORTLISTED, HIRED, REJECTED
  managerNotes String?
  resumeLink   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, status])
  @@index([email])
  @@index([status, createdAt])
}

// Personalized tutoring and 1-on-1 mentorship appointment schedules.
model OneOnOneBooking {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  level        String
  subjects     String[] @default([])
  slotDate     DateTime
  slotTime     String
  plan         String
  notes        String?
  userNotes    String?
  managerNotes String?
  status       String   @default("CONFIRMED") // CONFIRMED, RESCHEDULED, COMPLETED, CANCELLED
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([slotDate, status])
  @@index([email])
}

// Programmatic SEO landing pages generated dynamically for course and subject keywords.
model PseoPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  playbook        String
  title           String
  content         String
  metaDescription String?
  schemaMarkup    Json?
  isPublished     Boolean  @default(true)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([playbook, isPublished])
}

// Inbound prospect inquiries captured from lead magnets, landing pages, and marketing campaigns.
model LeadCapture {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  level       String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// =========================================================================
// EXAM GENZ & CODING LAB MODELS
// =========================================================================

// Formal timed examination instances administered under automated proctoring supervision.
model ProctoredExam {
  id               String                    @id @default(cuid())
  ownerId          String
  title            String
  subject          String
  instructions     String?
  durationMinutes  Int
  extensionMinutes Int                       @default(0)
  maxWarnings      Int                       @default(3)
  scheduledAt      DateTime
  closesAt         DateTime?
  status           String                    @default("DRAFT") // DRAFT, PUBLISHED, LIVE, PAUSED, ENDED, ARCHIVED
  resultsPublished Boolean                   @default(false)
  questions        Json // Frozen question snapshot list
  questionCount    Int                       @default(0)
  startedAt        DateTime?
  pausedAt         DateTime?
  pausedSeconds    Int                       @default(0)
  endedAt          DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  owner            User                      @relation("ExamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  enrollments      ProctoredExamEnrollment[]
  sessions         ProctoredExamSession[]
  events           ProctoredExamEvent[]
  messages         ProctoredExamMessage[]
  auditLogs        ProctoredExamAuditLog[]

  @@index([ownerId])
  @@index([status, scheduledAt])
}

// Whitelist roster defining students eligible to enter a proctored examination.
model ProctoredExamEnrollment {
  id        String        @id @default(cuid())
  examId    String
  email     String
  userId    String?
  createdAt DateTime      @default(now())
  exam      ProctoredExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([examId, email])
  @@index([examId])
  @@index([userId])
  @@index([email])
}

// Live state, current answers, infraction counter, and score for a proctored exam candidate.
model ProctoredExamSession {
  id               String        @id @default(cuid())
  examId           String
  userId           String
  status           String        @default("NOT_STARTED") // NOT_STARTED, IN_EXAM, LOCKED, SUBMITTED
  warnings         Int           @default(0)
  warningAllowance Int           @default(0)
  revision         Int           @default(0)
  answers          Json?
  score            Int?
  totalMarks       Int?
  scoreBreakdown   Json?
  joinedAt         DateTime?
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  exam             ProctoredExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([examId, status])
  @@index([userId])
}

// Fine-grained security telemetry recording tab switching, fullscreen exit, and blur infractions.
model ProctoredExamEvent {
  id            String        @id @default(cuid())
  examId        String
  userId        String
  clientEventId String        @unique
  type          String // blur, fullscreen_exit, visibility_hidden
  occurredAt    DateTime      @default(now())
  exam          ProctoredExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId, userId])
  @@index([occurredAt])
}

// Broadcast announcements or invigilator communications sent during an active exam.
model ProctoredExamMessage {
  id             String        @id @default(cuid())
  examId         String
  senderId       String
  text           String
  isAnnouncement Boolean       @default(false)
  createdAt      DateTime      @default(now())
  exam           ProctoredExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([examId, createdAt])
  @@index([senderId])
}

// Immutable security log capturing examiner actions such as pausing, extending, or locking exams.
model ProctoredExamAuditLog {
  id        String        @id @default(cuid())
  examId    String
  actorId   String
  event     String
  details   Json?
  createdAt DateTime      @default(now())
  exam      ProctoredExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  actor     User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([examId, createdAt])
  @@index([actorId])
}

// Programming challenges and coding problems with execution constraints.
model IdeProblem {
  id               String          @id @default(cuid())
  courseId         String?
  title            String
  description      String
  constraints      String?
  inputFormat      String?
  outputFormat     String?
  sampleInput      String?
  sampleOutput     String?
  difficulty       String          @default("EASY") // EASY, MEDIUM, HARD
  weekNumber       Int?
  language         String?
  timeLimitSeconds Int             @default(10)
  memoryLimitMb    Int             @default(256)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  course           Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  testCases        IdeTestCase[]
  submissions      IdeSubmission[]

  @@index([courseId, weekNumber, isActive])
}

// Automated test suites, public examples, and hidden test cases for coding challenges.
model IdeTestCase {
  id             String     @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean    @default(false)
  position       Int        @default(0)
  createdAt      DateTime   @default(now())
  problem        IdeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, position])
}

// Student source code submissions evaluated against challenge test cases.
model IdeSubmission {
  id              String     @id @default(cuid())
  problemId       String
  userId          String
  language        String
  code            String
  status          String     @default("PENDING") // ACCEPTED, WRONG_ANSWER, RUNTIME_ERROR, TIME_LIMIT_EXCEEDED, PENDING
  testResults     Json?
  executionTimeMs Int?
  memoryUsedKb    Int?
  createdAt       DateTime   @default(now())
  problem         IdeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId, userId])
  @@index([userId, createdAt])
  @@index([status])
}

// Curated video solutions and walkthroughs for course questions or exam problems.
model VideoSolution {
  id           String   @id @default(cuid())
  courseId     String?
  title        String
  provider     String   @default("youtube") // google_drive, youtube
  driveFileId  String?
  youtubeId    String?
  description  String?
  author       String?
  duration     String?
  thumbnailUrl String?
  chapters     Json? // Array of {time: number, title: string}
  isPro        Boolean  @default(false)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, isPublished])
  @@index([isPro, isPublished])
}

// Q&A forum questions, academic doubt threads, and peer discussions.
model Discussion {
  id              String            @id @default(cuid())
  userId          String
  courseId        String?
  subject         String?
  title           String
  body            String
  isAnonymous     Boolean           @default(false)
  linkedQuizId    String?
  acceptedReplyId String?
  isSolved        Boolean           @default(false)
  voteCount       Int               @default(0)
  replyCount      Int               @default(0)
  viewCount       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  linkedQuiz      Quiz?             @relation(fields: [linkedQuizId], references: [id], onDelete: SetNull)
  replies         DiscussionReply[]

  @@index([courseId, createdAt])
  @@index([userId])
  @@index([linkedQuizId])
  @@index([isSolved, createdAt])
}

// Community replies and instructor answers posted to discussion forum threads.
model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  userId       String
  body         String
  isAnonymous  Boolean    @default(false)
  isEndorsed   Boolean    @default(false)
  voteCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
  @@index([userId])
}

// Polymorphic upvotes/likes on discussion threads and replies.
model DiscussionVote {
  id          String   @id @default(cuid())
  userId      String
  votableType String // DISCUSSION, REPLY
  votableId   String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, votableType, votableId])
  @@index([votableType, votableId])
  @@index([userId])
}

// Singleton configuration for Pro membership pricing, trial periods, and payment gateways.
model ProPlanSettings {
  id                   String   @id @default(cuid())
  pricePaise           Int      @default(9900)
  googlePlayPricePaise Int?
  razorpayPlanId       String?
  trialDays            Int      @default(7)
  isEnabled            Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Ledger tracking active student memberships, renewals, trials, and payment provider tokens.
model ProSubscription {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String // razorpay, google_play, manual
  providerSubscriptionId String?
  providerReferenceHash  String?
  googlePurchaseToken    String?
  status                 String    @default("ACTIVE") // TRIALING, ACTIVE, CANCELLED, EXPIRED, REVOKED
  amountPaise            Int
  trialEndsAt            DateTime?
  currentPeriodEndsAt    DateTime?
  cancelledAt            DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([provider, providerSubscriptionId])
}

// Entitlements granting student access to commercial practice quizzes or mock exams.
model QuizEntitlement {
  id        String    @id @default(cuid())
  userId    String
  quizId    String
  orderId   String?
  source    String    @default("FREE_CLAIM") // FREE_CLAIM, PURCHASE, MANAGER_GRANT
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, quizId])
  @@index([quizId])
  @@index([userId, expiresAt])
  @@index([orderId])
}

// Student error reports highlighting typos, incorrect answer keys, or confusing questions.
model QuestionReport {
  id             String    @id @default(cuid())
  questionId     String
  quizId         String?
  userId         String
  questionNumber Int?
  reasons        Json // Array of reason tags
  comment        String
  status         String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  managerNote    String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz           Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  user           User      @relation("QuestionReporter", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy     User?     @relation("QuestionReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([questionId, status])
  @@index([quizId])
  @@index([userId])
  @@index([status, createdAt])
}

// Gamification badges and milestone awards unlocked by learners for platform achievements.
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badge     String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
  @@index([badge])
}

// Acceptable answer strings and regex patterns for automatically evaluating fill-in-the-blank questions.
model ShortAnswerAcceptable {
  id             String   @id @default(cuid())
  questionId     String
  acceptableText String
  createdAt      DateTime @default(now())
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}
